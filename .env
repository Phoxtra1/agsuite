# Shared Appwrite backend (same for ALL apps)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=ag-suite03
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
VITE_COMSSYSTEM_ENDPOINT=https://coms.amineva.com/a1
VITE_COMS_API_BASE=https://coms.amineva.com/a1
VITE_COMS_MOCK_MODE=true
VITE_COMS_TIMEOUT_MS=12000

# Identify which app this build is
VITE_APP_NAME=ag-suite
VITE_SUITE_CENTRAL_AUTH=true
VITE_DISABLE_PRODUCT_AUTH=true

# Suite resources (Suite collections/bucket)
VITE_DB_ID=agsuite-db2
VITE_MODULES_COLLECTION_ID=modules
VITE_USER_ACCESS_COLLECTION_ID=module_access
VITE_ASSETS_BUCKET_ID=suite_assets

# Appwrite Function IDs used by Suite (optional)
VITE_SUITE_FUNCTION_ID=69689f59003426b9e5e3
